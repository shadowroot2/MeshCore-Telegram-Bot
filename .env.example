# MeshCore Telegram Bot — конфигурация.
# Скопируйте файл в .env и заполните значения.
# Переменные окружения имеют приоритет над этим файлом.

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Числовой id группы-форума с вкладками (обязательно, с минусом).
# Группа должна быть с включёнными «Темами» (Topics), бот — админ с правом
# создания тем. Узнать id: переслать сообщение группы боту @userinfobot.
TARGET_CHAT_ID=

# ip:port радио (ZephCore companion, TCP). Должен быть достижим из контейнера:
# 127.0.0.1 внутри контейнера — это не хост.
RADIO_ADDR=127.0.0.1:5000

# Канал по умолчанию — сюда попадают сообщения из вкладки General
CHANNEL_NAME=Public

# Файл с соответствием «вкладка <-> mesh-адрес» (переживает перезапуск)
TOPICS_FILE=topics.json
